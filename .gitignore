# 当前环境的 Git 元数据位于显式工作树目录，避免把它自身纳入版本库
.git-real/

# 第一阶段研究交付物
!docs/
!docs/AI_CSI_*.md
!outputs/
!outputs/ai_csi_oracle/
!outputs/ai_csi_oracle/**

# 生成的原始回放包和逐案例中间结果只留在工作区，不复制进 Git 历史
outputs/ai_csi_oracle/stage2_target/
outputs/ai_csi_oracle/stage2_background/
outputs/ai_csi_oracle/nonideal_target/
outputs/ai_csi_oracle/nonideal_background/
outputs/ai_csi_oracle/nonideal/
outputs/ai_csi_oracle/per_case/

# 第一轮 baseline benchmark：只保留紧凑汇总和图，原始 BIN/临时配置不入库
!outputs/ai_csi_baseline/
!outputs/ai_csi_baseline/*.csv
!outputs/ai_csi_baseline/*.png
!outputs/ai_csi_baseline/*.json
outputs/ai_csi_baseline/cases/
outputs/ai_csi_baseline/generated_configs/

# V2.1 experiments are ignored during the clean-source rerun; after the
# results are complete, compact CSV/JSON/PNG files are explicitly unignored
# for the result commit while case BIN/config directories remain ignored.
outputs/ai_csi_baseline_v21/
outputs/ai_csi_baseline_v21_*/

# Final V2.1 compact evidence from the clean source commit.  Keep generated
# case configs/BINs ignored; track only auditable CSV/JSON/PNG summaries.
!outputs/ai_csi_baseline_v21_final_screen/
!outputs/ai_csi_baseline_v21_final_screen/*.csv
!outputs/ai_csi_baseline_v21_final_screen/*.json
!outputs/ai_csi_baseline_v21_final_screen/*.png
outputs/ai_csi_baseline_v21_final_screen/cases/
outputs/ai_csi_baseline_v21_final_screen/generated_configs/

