!outputs/ai_csi_baseline_v21_final_screen/*.json
!outputs/ai_csi_baseline_v21_final_screen/*.png
outputs/ai_csi_baseline_v21_final_screen/cases/
outputs/ai_csi_baseline_v21_final_screen/generated_configs/

